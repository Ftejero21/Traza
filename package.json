{
  "name": "traza",
  "displayName": "Traza",
  "description": "Visualización del flujo de un proceso del proyecto (diagrama de secuencia, simular datos, analizar logs y proponer cambios) con el modelo de lenguaje que ya usas en VS Code. El código relevante (sin archivos sensibles y con secretos enmascarados) se envía al proveedor de ese modelo.",
  "publisher": "ftejero21",
  "version": "0.1.1",
  "license": "MIT",
  "author": {
    "name": "Fernando Tejero"
  },
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1220",
    "theme": "dark"
  },
  "homepage": "https://github.com/Ftejero21/Traza#readme",
  "bugs": {
    "url": "https://github.com/Ftejero21/Traza/issues"
  },
  "qna": "marketplace",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ftejero21/Traza.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Visualization"
  ],
  "keywords": [
    "flow",
    "sequence diagram",
    "diagrama de secuencia",
    "flujo",
    "copilot",
    "chat",
    "ai",
    "angular",
    "spring",
    "spring boot",
    "debugging",
    "simulación",
    "logs",
    "database",
    "architecture",
    "traza"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "En espacios de trabajo no confiables, Traza no usa las conexiones de base de datos definidas en la configuración del workspace (traza.databases); solo las de la configuración de usuario. Traza no ejecuta código del proyecto.",
      "restrictedConfigurations": [
        "traza.databases"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Lee el código mediante el sistema de archivos de VS Code; la conexión a bases de datos y VS Code para la Web no están soportados."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onChatParticipant:traza.flow",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "traza.openFlow",
        "title": "Traza: Flujo",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "traza.openSampleFlow",
        "title": "Traza: Abrir flujo de ejemplo"
      },
      {
        "command": "traza.generateFlow",
        "title": "Traza: Generar flujo",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "traza.proposeChange",
        "title": "Traza: Proponer cambio"
      },
      {
        "command": "traza.selectModel",
        "title": "Traza: Elegir modelo"
      },
      {
        "command": "traza.showLastFlow",
        "title": "Traza: Mostrar último flujo generado"
      },
      {
        "command": "traza.showFlow",
        "title": "Traza: Visualizar flujo"
      },
      {
        "command": "traza.addDatabase",
        "title": "Traza: Añadir conexión de base de datos"
      },
      {
        "command": "traza.setDatabasePassword",
        "title": "Traza: Contraseña de base de datos"
      },
      {
        "command": "traza.testDatabase",
        "title": "Traza: Probar conexión de base de datos"
      },
      {
        "command": "traza.removeDatabase",
        "title": "Traza: Quitar conexión de base de datos"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "traza.openFlow",
          "when": "resourceFilename =~ /\\.flow\\.json$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "traza.generateFlow",
          "when": "editorTextFocus",
          "group": "traza"
        }
      ],
      "commandPalette": [
        {
          "command": "traza.showFlow",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Traza",
      "properties": {
        "traza.model": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "vendor": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "markdownDescription": "Modelo de VS Code (Copilot, Claude, GPT, BYOK…) que usa Traza; vacío = elegir al usarlo. Usa **Traza: Elegir modelo**. El código relevante (sin archivos sensibles y con secretos enmascarados) se envía al proveedor de ese modelo."
        },
        "traza.language": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "default": "es",
          "description": "Idioma de la vista de flujo y de las respuestas de la IA."
        },
        "traza.theme": {
          "type": "string",
          "enum": [
            "traza",
            "vscode"
          ],
          "default": "traza",
          "enumDescriptions": [
            "Paleta original de Traza, oscura o clara según el tema de VS Code",
            "Sigue los colores y fuentes del tema de VS Code"
          ],
          "description": "Apariencia de la vista de flujo."
        },
        "traza.databases": {
          "type": "array",
          "default": [],
          "description": "Conexiones de base de datos para el modo «Base de datos» de la vista de flujo (solo se lee la metadata, en solo lectura). La contraseña NO va aquí: se guarda en el almacén seguro de VS Code con \"Traza: Contraseña de base de datos\".",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "provider",
              "host",
              "port",
              "database",
              "user"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$",
                "description": "Identificador único de la conexión."
              },
              "name": {
                "type": "string",
                "description": "Nombre visible."
              },
              "provider": {
                "type": "string",
                "enum": [
                  "postgresql",
                  "mysql",
                  "mariadb"
                ],
                "description": "Proveedor de base de datos."
              },
              "host": {
                "type": "string",
                "description": "Servidor (sin TLS solo se permite localhost)."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Puerto."
              },
              "database": {
                "type": "string",
                "description": "Base de datos."
              },
              "user": {
                "type": "string",
                "description": "Usuario (se recomienda uno de solo lectura)."
              },
              "schema": {
                "type": "string",
                "default": "public",
                "description": "Esquema (solo PostgreSQL)."
              },
              "root": {
                "type": "string",
                "default": "",
                "description": "Carpeta del proyecto que usa esta base de datos (relativa al workspace; vacío = todas)."
              },
              "ssl": {
                "type": "boolean",
                "default": false,
                "description": "Conexión TLS verificando el certificado (obligatoria para servidores remotos)."
              }
            }
          }
        }
      }
    },
    "chatParticipants": [
      {
        "id": "traza.flow",
        "name": "traza",
        "fullName": "Traza",
        "description": "Genera el flujo de un proceso del proyecto y propone cambios",
        "isSticky": false,
        "commands": [
          {
            "name": "flujo",
            "description": "Generar diagrama de flujo"
          },
          {
            "name": "cambio",
            "description": "Proponer un cambio (genera el flujo si hace falta) y abrirlo en «Simular cambios»"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build:webview": "npm --prefix webview run build",
    "build:host": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --external:pg-native --external:pg-cloudflare",
    "build": "npm run build:webview && npm run build:host",
    "watch:host": "npm run build:host -- --watch",
    "serve:webview": "npm --prefix webview start",
    "typecheck": "tsc --noEmit -p .",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "package:ls": "vsce ls --no-dependencies"
  },
  "dependencies": {
    "mysql2": "^3.9.7",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/pg": "^8.11.6",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.20.2",
    "typescript": "~5.4.2"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
